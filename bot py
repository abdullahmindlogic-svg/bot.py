@bot.message_handler(
    content_types=["text"]
)
def text_handler(message):

    try:

        save_user(message)

        user_id = message.from_user.id
        user_text = clean_text(message.text)

        # ----------------------------------------------------
        # Save user message
        # ----------------------------------------------------

        save_all_memory(
            user_id,
            "user",
            user_text
        )

        # ----------------------------------------------------
        # Direct request check
        # ----------------------------------------------------

        if is_direct_request(user_text):

            answer = smart_response(message)

            save_all_memory(
                user_id,
                "assistant",
                answer
            )

            # Direct request-এ কোনো Button দেওয়া হবে না
            bot.send_message(
                message.chat.id,
                answer
            )

            return

        # ----------------------------------------------------
        # Normal response
        # ----------------------------------------------------

        answer = smart_response(message)

        save_all_memory(
            user_id,
            "assistant",
            answer
        )

        # Contact request-এ button
        t = normalize(user_text)

        if contains_any(t, [
            "যোগাযোগ",
            "contact",
            "contact owner",
            "contact creator"
        ]):

            bot.send_message(
                message.chat.id,
                answer,
                reply_markup=contact_menu()
            )

        elif contains_any(t, [
            "menu",
            "মেনু"
        ]):

            bot.send_message(
                message.chat.id,
                answer,
                reply_markup=main_menu()
            )

        else:

            bot.send_message(
                message.chat.id,
                answer
            )

    except Exception as e:

        print("Message handler error:", e)

        try:
            bot.send_message(
                message.chat.id,
                (
                    "দুঃখিত, এই মুহূর্তে একটি ছোট সমস্যা হয়েছে। "
                    "কিছুক্ষণ পর আবার চেষ্টা করুন।"
                )
            )
        except Exception:
            pass


