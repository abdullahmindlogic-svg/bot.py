def firebase_save(user_id, role, message):
    """
    Firebase Firestore REST API-তে memory save করার চেষ্টা করে।

    Firebase Security Rules যদি unauthenticated write অনুমতি না দেয়,
    তাহলে এটি ব্যর্থ হতে পারে। সেই ক্ষেত্রে Local SQLite memory
    স্বাভাবিকভাবে কাজ করবে।
    """

    try:
        document_id = (
            str(user_id)
            + "_"
            + str(int(time.time() * 1000))
        )

        url = (
            FIRESTORE_URL
            + "/bot_memory/"
            + document_id
            + "?key="
            + FIREBASE_API_KEY
        )

        data = {
            "fields": {
                "user_id": {
                    "integerValue": str(user_id)
                },
                "role": {
                    "stringValue": role
                },
                "message": {
                    "stringValue": message
                },
                "created_at": {
                    "stringValue": now()
                }
            }
        }

        response = requests.post(
            url,
            json=data,
            timeout=10
        )

        if response.status_code not in (200, 201):
            print(
                "Firebase save failed:",
                response.status_code,
                response.text[:300]
            )

    except Exception as e:
        print("Firebase error:", e)


def save_all_memory(user_id, role, message):
    # Local memory immediately
    save_memory(
        user_id,
        role,
        message
    )

    # Firebase background save
    threading.Thread(
        target=firebase_save,
        args=(user_id, role, message),
        daemon=True
    ).start()


