def extract_search_query(text):
    t = clean_text(text)

    patterns = [
        r"(?:search|find|খুঁজে দাও|খুজে দাও|খুঁজে দিন|খুজে দিন)\s+(.+)",
        r"(?:download|ডাউনলোড)\s+(.+)",
        r"(?:অ্যাপ|app)\s+(.+)",
        r"(?:গেম|game)\s+(.+)",
    ]

    for pattern in patterns:
        match = re.search(
            pattern,
            t,
            flags=re.IGNORECASE
        )

        if match:
            query = match.group(1).strip()

            if query:
                return query

    return t


def search_web(query):
    """
    DuckDuckGo HTML search ব্যবহার করে সাধারণ search result আনার চেষ্টা।

    কোনো API key দরকার নেই।
    Search result-এর ওপর নির্ভর করে availability পরিবর্তিত হতে পারে।
    """

    try:
        url = "https://html.duckduckgo.com/html/"

        response = requests.get(
            url,
            params={"q": query},
            headers={
                "User-Agent":
                    "Mozilla/5.0 (Android) AppleWebKit/537.36 "
                    "Chrome/120 Mobile Safari/537.36"
            },
            timeout=10
        )

        if response.status_code != 200:
            return []

        html = response.text

        results = []

        # DuckDuckGo result link extraction
        pattern = re.compile(
            r'class="result__a"[^>]*href="([^"]+)"[^>]*>(.*?)</a>',
            re.IGNORECASE | re.DOTALL
        )

        for match in pattern.finditer(html):
            link = match.group(1)

            title = re.sub(
                r"<.*?>",
                "",
                match.group(2)
            )

            title = title.strip()

            if title and link:
                results.append(
                    {
                        "title": title,
                        "link": link
                    }
                )

            if len(results) >= 5:
                break

        return results

    except Exception as e:
        print("Search error:", e)
        return []


def app_search_response(text):
    query = extract_search_query(text)

    if not query:
        return (
            "📱 কোন App বা Game খুঁজছেন?\n\n"
            "উদাহরণ:\n"
            "<code>CapCut app</code>\n"
            "<code>Android game</code>"
        )

    results = search_web(query)

    if not results:
        return (
            "দুঃখিত, এই মুহূর্তে Search Result পাওয়া যাচ্ছে না।\n\n"
            f"🔎 Search: <b>{query}</b>"
        )

    answer = (
        f"🔎 <b>Search Result</b>\n"
        f"Query: <code>{query}</code>\n\n"
    )

    for i, item in enumerate(results, 1):
        title = item["title"]
        link = item["link"]

        answer += (
            f"{i}. <b>{title}</b>\n"
            f"{link}\n\n"
        )

    return answer


