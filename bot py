def get_statistics():
    try:
        with db_lock:
            total_users = db.execute(
                "SELECT COUNT(*) FROM users"
            ).fetchone()[0]

            total_messages = db.execute(
                "SELECT COALESCE(SUM(message_count), 0) FROM users"
            ).fetchone()[0]

        return total_users, total_messages

    except Exception as e:
        print("Statistics error:", e)
        return 0, 0


def get_statistics_text():
    users, messages = get_statistics()

    return (
        "📊 <b>Bot Statistics</b>\n\n"
        f"👥 Users: <b>{users}</b>\n"
        f"💬 Messages: <b>{messages}</b>\n"
        f"🤖 Bot: <b>{BOT_NAME}</b>"
    )


