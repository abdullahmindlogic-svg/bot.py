def save_user(message):
    try:
        user = message.from_user

        user_id = user.id
        username = user.username or ""
        first_name = user.first_name or ""
        last_name = user.last_name or ""

        current = now()

        with db_lock:
            existing = db.execute(
                "SELECT user_id, message_count FROM users WHERE user_id=?",
                (user_id,)
            ).fetchone()

            if existing:
                db.execute("""
                    UPDATE users
                    SET username=?,
                        first_name=?,
                        last_name=?,
                        message_count=?,
                        last_seen=?
                    WHERE user_id=?
                """, (
                    username,
                    first_name,
                    last_name,
                    existing[1] + 1,
                    current,
                    user_id
                ))
            else:
                db.execute("""
                    INSERT INTO users
                    (
                        user_id,
                        username,
                        first_name,
                        last_name,
                        language,
                        message_count,
                        first_seen,
                        last_seen
                    )
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?)
                """, (
                    user_id,
                    username,
                    first_name,
                    last_name,
                    "unknown",
                    1,
                    current,
                    current
                ))

            db.commit()

    except Exception as e:
        print("save_user error:", e)


def save_memory(user_id, role, message):
    try:
        with db_lock:
            db.execute("""
                INSERT INTO memory
                (user_id, role, message, created_at)
                VALUES (?, ?, ?, ?)
            """, (
                user_id,
                role,
                message,
                now()
            ))

            # প্রতিটি user-এর সর্বশেষ 100 message রাখবে
            db.execute("""
                DELETE FROM memory
                WHERE user_id=?
                AND id NOT IN (
                    SELECT id
                    FROM memory
                    WHERE user_id=?
                    ORDER BY id DESC
                    LIMIT 100
                )
            """, (user_id, user_id))

            db.commit()

    except Exception as e:
        print("save_memory error:", e)


def get_memory(user_id, limit=20):
    try:
        with db_lock:
            rows = db.execute("""
                SELECT role, message
                FROM memory
                WHERE user_id=?
                ORDER BY id DESC
                LIMIT ?
            """, (
                user_id,
                limit
            )).fetchall()

        rows.reverse()
        return rows

    except Exception as e:
        print("get_memory error:", e)
        return []


